# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=joka_user
DATABASE_PASSWORD=joka_password
DATABASE_NAME=joka_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_REFRESH_EXPIRATION=30d

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=joka-uploads

# Mobile Money - Orange Money
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay/
ORANGE_MONEY_MERCHANT_KEY=your-orange-merchant-key
ORANGE_MONEY_API_KEY=your-orange-api-key

# Mobile Money - MTN
MTN_MONEY_API_URL=https://sandbox.momodeveloper.mtn.com/
MTN_MONEY_USER_ID=your-mtn-user-id
MTN_MONEY_API_KEY=your-mtn-api-key
MTN_MONEY_SUBSCRIPTION_KEY=your-mtn-subscription-key

# Mobile Money - Moov
MOOV_MONEY_API_URL=https://api.moov-africa.ci/
MOOV_MONEY_MERCHANT_ID=your-moov-merchant-id
MOOV_MONEY_API_KEY=your-moov-api-key

# Mobile Money - Wave
WAVE_API_URL=https://api.wave.com/
WAVE_API_KEY=your-wave-api-key
WAVE_SECRET_KEY=your-wave-secret-key

# App
NODE_ENV=development
PORT=3000
API_PREFIX=api
FRONTEND_URL=http://localhost:3001

# Admin
ADMIN_EMAIL=admin@joka.ci
ADMIN_PASSWORD=change-this-password
